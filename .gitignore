# .gitignore for an asset repository
#
# Media files are the content of this repository, so no media extension is
# ignored here. Only local, generated, and editor-specific files are.

# Log files
**/*.log

# dotenv environment variables file
**/.env

# JetBrains IDEs
**/.idea/
**/*.iml

# AI
.claude/worktree
.claude/*.local.json

# Visual Studio Code IDE
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
!**/.vscode/extensions.json
!**/.vscode/*.code-snippets

# Local History for Visual Studio Code
.history/

# Generated by MacOS
.DS_Store
.AppleDouble
.LSOverride

# Generated by Windows
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Archives unpacked next to their source
**/*.zip.tmp
