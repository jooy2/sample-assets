# Normalize line endings for text, and keep binaries untouched.
* text=auto eol=lf

# Data formats
*.csv   text eol=lf
*.tsv   text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.sql   text eol=lf
*.xml   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.svg   text eol=lf

# Images
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.psd  binary

# Video
*.mp4  binary
*.webm binary
*.mov  binary

# Audio
*.mp3  binary
*.wav  binary
*.ogg  binary
*.flac binary
*.m4a  binary

# Documents
*.adoc text eol=lf
*.rst  text eol=lf
*.tex  text eol=lf
*.rtf  text eol=lf
*.odt  binary
*.pdf  binary
*.doc  binary
*.docx binary
*.xls  binary
*.xlsx binary
*.ppt  binary
*.pptx binary

# Source code
*.c     text eol=lf
*.h     text eol=lf
*.cpp   text eol=lf
*.hpp   text eol=lf
*.cs    text eol=lf
*.dart  text eol=lf
*.go    text eol=lf
*.java  text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.ts    text eol=lf
*.kt    text eol=lf
*.php   text eol=lf
*.py    text eol=lf
*.rb    text eol=lf
*.rs    text eol=lf
*.sh    text eol=lf
*.swift text eol=lf
*.html  text eol=lf
*.css   text eol=lf

# Samples are content, not the source of a program. Keep them out of the
# language statistics GitHub shows for this repository - otherwise this reads
# as a project written in fifteen languages at once.
datasets/** linguist-detectable=false
documents/** linguist-detectable=false
code/** linguist-detectable=false
