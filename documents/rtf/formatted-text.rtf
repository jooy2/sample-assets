\pard\sa180\sb240\keepn\b\f1\fs32 RTF formatting showcase\b0\f0\fs22\par
\pard\sa120\sl276\slmult1 One file exercising the character and paragraph formatting an RTF reader is usually asked to render.\par
\pard\sa180\sb240\keepn\b\f1\fs28 Character formatting\b0\f0\fs22\par
\pard\sa120 Plain, {\b bold}, {\i italic}, {\ul underlined}, {\strike struck through}, {\b\i bold italic}, {\scaps small capitals}, {\caps all capitals}, {\v hidden text}, and {\f2 a monospaced run}.\par
\pard\sa120 Sizes: {\fs16 8pt} {\fs22 11pt} {\fs28 14pt} {\fs40 20pt}. Colours: {\cf1 green} {\cf4 blue} {\cf3 red} {\cf5 grey}. Highlight: {\highlight2 a shaded run}.\par
\pard\sa120 Super{\super script} and sub{\sub script}, H{\sub 2}O, x{\super 2} + y{\super 2} = z{\super 2}.\par
\pard\sa180\sb240\keepn\b\f1\fs28 Paragraph alignment\b0\f0\fs22\par
\pard\sa120\sl276\slmult1\ql This paragraph is left aligned, which is the default.\par
\pard\sa120\sl276\slmult1\qc This paragraph is centred.\par
\pard\sa120\sl276\slmult1\qr This paragraph is right aligned.\par
\pard\sa120\sl276\slmult1\qj This paragraph is justified, so the renderer stretches the spaces between its words until both edges line up. It needs to run to at least two lines before the effect is visible at all, which is why it says so little at such length.\par
\pard\sa180\sb240\keepn\b\f1\fs28 Indentation and spacing\b0\f0\fs22\par
\pard\sa120\sl276\slmult1\fi567 A first-line indent of one centimetre.\par
\pard\sa120\sl276\slmult1\fi-567\li567 A hanging indent, where the first line starts to the left of the rest of the paragraph and every following line is pushed in.\par
\pard\sa120\sl276\slmult1\li567\ri567 A block indented from both sides, as a quotation might be.\par
\pard\sa180\sb240\keepn\b\f1\fs28 Lists\b0\f0\fs22\par
\pard\fi-284\li568\sa60{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}} First bulleted item\par
\pard\fi-284\li568\sa60{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}} Second bulleted item\par
\pard\fi-284\li568\sa60{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}} Third bulleted item\par
